# Copy to .env locally, or add these as GitHub Actions "Repository secrets"
# (Settings -> Secrets and variables -> Actions) with the same names.
# Nothing here is required to GENERATE videos — only to auto-POST them.

# --- Instagram (Meta Graph API) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=

# --- Where generated videos get uploaded so Meta/TikTok can fetch them ---
# Simplest free option: a public GitHub repo + GitHub Release asset URL,
# or raw.githubusercontent.com. See README "Hosting the video file".
PUBLIC_VIDEO_BASE_URL=
